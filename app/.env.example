# ============================================
# ExoDuZe Frontend — Environment Configuration
# ============================================
# SECURITY WARNING:
#   1. Copy this file to .env.local for local development
#   2. NEVER commit .env.local to version control
#   3. Only NEXT_PUBLIC_ prefixed vars are exposed to the browser
#
# All keys here are PUBLIC (anon-level) — safe for client-side use.
# Never put service_role keys or secrets in the frontend env.

# ===================
# Supabase Configuration (Public / Anon-level only)
# Get from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
# ===================
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=sb_publishable_your_publishable_key

# ===================
# Backend API URL
# ===================
# Local development
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
# Production (uncomment and set your production URL)
# NEXT_PUBLIC_API_URL=https://your-api-domain.com/api/v1
