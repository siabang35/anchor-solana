# ============================================
# ExoDuZe API — Environment Configuration
# ============================================
# SECURITY WARNING:
#   1. Copy this file to .env for local development
#   2. NEVER commit .env or .env.local to version control
#   3. Use strong, unique secrets in production
#
# Generate secrets:
#   JWT/Session:  openssl rand -base64 48
#   Encryption:   openssl rand -hex 32
#   HMAC Secrets: openssl rand -hex 32

# ===================
# Server Configuration
# ===================
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1

# ===================
# Supabase Configuration
# Get keys from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
# ===================
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ===================
# Database (Direct PostgreSQL Connection)
# From Supabase: Settings > Database > Connection string
# ===================
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# ===================
# JWT Configuration
# IMPORTANT: Use minimum 32 character secrets
# Generate with: openssl rand -base64 48
# ===================
JWT_SECRET=your_jwt_secret_minimum_32_characters_long_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_refresh_secret_minimum_32_characters_long_here
JWT_REFRESH_EXPIRES_IN=7d

# ===================
# Privy Wallet Infrastructure (Required for wallet generation)
# Get from: https://dashboard.privy.io/
# ===================
PRIVY_APP_ID=your_privy_app_id
PRIVY_APP_SECRET=your_privy_app_secret

# ===================
# Google OAuth (Optional)
# Get from: https://console.cloud.google.com/apis/credentials
# Required scopes: email, profile
# ===================
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

# ===================
# Security Configuration
# ===================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:3001

# Rate limiting (requests per window)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_MAX=50

# Brute Force Protection
LOCKOUT_THRESHOLD=5
LOCKOUT_DURATION_MINUTES=15

# Encryption key for sensitive data at rest (64 hex characters)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# ===================
# Sports Data API Keys
# ===================
# API-Football: https://www.api-football.com/
APIFOOTBALL_API_KEY=your_apifootball_api_key
# TheSportsDB: https://www.thesportsdb.com/api.php (free tier = "123")
THESPORTSDB_API_KEY=123

# ===================
# Market Data & News API Keys
# All optional — graceful degradation if not set
# ===================
# NewsAPI: https://newsapi.org/
NEWSAPI_KEY=your_newsapi_key
# Alpha Vantage: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key
# CoinMarketCap: https://pro.coinmarketcap.com/
COINMARKETCAP_API_KEY=your_coinmarketcap_key
# CryptoPanic: https://cryptopanic.com/developers/api/
CRYPTOPANIC_API_KEY=your_cryptopanic_key
# FRED (Federal Reserve): https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key

# ===================
# AI / LLM API Keys
# ===================
# HuggingFace: https://huggingface.co/settings/tokens
# Used for NLP sentiment analysis (FinBERT, distilbert-sst2)
HUGGINGFACE_TOKEN=hf_your_huggingface_token
# Groq: https://console.groq.com/keys
# Used for fast LLM inference (agent predictions)
GROQ_API_KEY=gsk_your_groq_api_key
# OpenRouter: https://openrouter.ai/keys
# Used as LLM fallback (Qwen, etc.)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key

# ===================
# NLP Sentiment Analysis Configuration
# ===================
# Enable real NLP sentiment (HuggingFace Inference API)
# When true, uses FinBERT/distilbert for sentiment instead of keyword matching
NLP_SENTIMENT_ENABLED=true
# Model to use: 'finbert' (financial) or 'distilbert' (general)
NLP_SENTIMENT_MODEL=finbert
# Max concurrent inference requests (rate limit protection)
NLP_SENTIMENT_CONCURRENCY=5
# Cache TTL in ms for sentiment results (avoid re-analyzing same text)
NLP_SENTIMENT_CACHE_TTL_MS=3600000

# ===================
# Cookie Configuration
# ===================
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# ===================
# Logging & Monitoring
# Options: error, warn, log, debug, verbose
# ===================
LOG_LEVEL=debug
ENABLE_AUDIT_LOG=true

# ===================
# Messaging & Streaming (RabbitMQ / CloudAMQP)
# ===================
# CloudAMQP: https://www.cloudamqp.com/
RABBITMQ_URL=amqps://user:pass@hostname/vhost
RABBITMQ_HOST=hostname.lmq.cloudamqp.com
RABBITMQ_PORT=5671
RABBITMQ_USER=your_rabbitmq_user
RABBITMQ_PASSWORD=your_rabbitmq_password
RABBITMQ_VHOST=your_rabbitmq_vhost
MARKET_MESSAGING_ENABLED=true

# WebSocket Rate Limiting
WS_RATE_LIMIT=50
WS_BATCH_INTERVAL=100
WS_MAX_SUBSCRIPTIONS=10

# ===================
# Session Configuration
# Generate with: openssl rand -base64 32
# ===================
SESSION_SECRET=

# ===================
# SMTP Email Configuration (Brevo / SendGrid / Gmail)
# ===================
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=noreply@yourdomain.com
SMTP_KEY=your_smtp_api_key

# ===================
# HMAC Integrity Secrets
# Generate each with: openssl rand -hex 32
# CRITICAL for production — prevents data tampering
# ===================
CURVE_HMAC_SECRET=your_64_hex_char_secret_here
COMPETITION_HMAC_SECRET=your_64_hex_char_secret_here
LEADERBOARD_HMAC_SECRET=your_64_hex_char_secret_here

# ===================
# Solana Configuration (Devnet)
# ===================
# Treasury keypair for on-chain stake TXs & prize disbursement
# Generate with: solana-keygen new --no-bip39-passphrase
SOLANA_TREASURY_PRIVATE_KEY=your_base58_encoded_private_key

# ===================
# Production Checklist
# ===================
# Before deploying to production, ensure:
# [ ] NODE_ENV=production
# [ ] COOKIE_SECURE=true
# [ ] COOKIE_SAME_SITE=strict
# [ ] LOG_LEVEL=info or warn
# [ ] All secrets are unique and strong (32+ chars)
# [ ] CORS_ORIGINS contains only production domains
# [ ] Database uses connection pooler (port 6543)
# [ ] All HMAC secrets are set (not ephemeral)
# [ ] NLP_SENTIMENT_ENABLED=true with valid HUGGINGFACE_TOKEN
